generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model House {
  id          String   @id @default(uuid())
  name        String
  inviteCode  String   @unique
  adminId     String
  listas      Json     @default("[{\"nombre\": \"Mi Compra\", \"icono\": \"🛒\", \"color\": \"#e0f0ff\"}]")
  users       User[]   
  items       Item[]
  menuSemanal Json?    
  createdAt   DateTime @default(now())
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  name        String
  password    String
  // Desaparecen houseId y house, y entra la nueva relación:
  houses      House[]  // Un usuario tiene una lista de casas
  
  addedItems  Item[]   @relation("UserItems")
  createdAt   DateTime @default(now())

  resetCode   String?
  resetCodeExpiry DateTime?
}

model Item {
  id           String   @id @default(uuid())
  name         String
  houseId      String
  house        House    @relation(fields: [houseId], references: [id])
  addedById    String?
  addedBy      User?    @relation("UserItems", fields: [addedById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  comprado     Boolean  @default(false)
  supermercado String   @default("general") // <-- NUEVO CAMPO
  categoria    String   @default("Otros")
  creador      String   @default("Anónimo")
}

model Receta {
  id           String        @id @default(uuid())
  nombre       String
  categoria    String
  instrucciones String?
  ingredientes Ingrediente[]
}

model Ingrediente {
  id       String @id @default(uuid())
  nombre   String
  recetaId String
  receta   Receta @relation(fields: [recetaId], references: [id], onDelete: Cascade)
}